// Shared build settings. Safe to commit.
//
// Signing values are personal, so they live in Local.xcconfig next to this file.
// That file is gitignored; XcodeGen regenerates the project, but never this file.
// Local.xcconfig usually contains:
//
//   DEVELOPMENT_TEAM = YOUR_TEAM_ID
//   CODE_SIGN_STYLE = Automatic
//
// Without it, Xcode simply asks for a team as usual.

// Fallback when Local.xcconfig is absent; Local may pin a certificate hash.
SIFT_SIGNING_IDENTITY = Apple Development

#include? "Local.xcconfig"
